// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

// Enums for the trip management system
enum UserRole {
    USER
    ADMIN
    SUPER_ADMIN
}

enum TripRequestStatus {
    PENDING
    QUOTED
    ACCEPTED
    CONFIRMED
    REJECTED
    COMPLETED
    CANCELLED
}

enum QuotationStatus {
    PENDING
    ACCEPTED
    REJECTED
}

enum MessageSenderType {
    CUSTOMER
    ADMIN
}

enum RouteType {
    airport_in
    airport_out
    standard
}

enum NotificationType {
    NEW_MESSAGE
    TRIP_DETAILS_UPDATED
    QUOTATION_ACCEPTED
    QUOTATION_REJECTED
}

model Company {
    id               String   @id @default(cuid())
    name             String
    slug             String   @unique
    logoUrl          String?
    isActive         Boolean  @default(true)
    vat              String?
    address          String?
    country          String?
    website          String?
    phone             String?
    estimateNotice    String?  @db.Text
    brandColor        String?
    coverPhotoUrl     String?
    emailPreferences  Json?
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    users        User[]
    tripRequests TripRequest[]
    drivers      Driver[]

    @@index([slug])
}

model Driver {
    id        String   @id @default(cuid())
    companyId String
    company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
    name      String
    surname   String
    phone     String
    email     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([companyId])
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? @db.Text
    access_token             String? @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String         @id @default(cuid())
    name          String?
    email         String?        @unique
    emailVerified DateTime?
    password      String?
    image         String?
    role              UserRole       @default(USER)
    privacyAcceptedAt DateTime?
    preferredLanguage String         @default("en")
    companyId         String?
    company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
    accounts      Account[]
    sessions      Session[]
    tripRequests  TripRequest[]
    quotations    Quotation[]
    notifications Notification[]

    @@index([companyId])
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model PasswordResetToken {
    id        String   @id @default(cuid())
    email     String
    token     String   @unique
    expires   DateTime
    createdAt DateTime @default(now())

    @@index([email])
}

// Trip management models
model TripRequest {
    id          String            @id @default(cuid())
    token       String            @unique @default(cuid())
    orderNumber Int               @unique @default(autoincrement())
    status      TripRequestStatus @default(PENDING)

    // Travel information
    customerEmail      String
    language           String
    firstName          String
    lastName           String
    phone              String
    numberOfAdults     Int
    areThereChildren   Boolean @default(false)
    numberOfChildren   Int?
    ageOfChildren      String? @db.Text
    numberOfChildSeats Int?
    additionalInfo     String? @db.Text
    internalNotes      String? @db.Text

    // Privacy consent
    privacyAcceptedAt DateTime?

    lastViewedAt                  DateTime?
    confirmedAt                   DateTime?
    departureDetailsRequestedAt   DateTime?
    pickupInfoNotifiedAt          DateTime?
    lastCustomerActivityAt        DateTime?
    adminViewedAt                 DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    userId     String?
    user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
    companyId  String?
    company    Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
    quotations    Quotation[]
    messages      TripMessage[]
    routes        Route[]
    notifications Notification[]

    @@index([userId])
    @@index([companyId])
    @@index([status])
    @@index([createdAt])
}

model Route {
    id       String    @id @default(cuid())
    position Int
    type     RouteType @default(standard)

    pickup      String
    destination String

    // Filled by customer after accepting quotation
    scheduledDate String?
    scheduledTime String?
    flightNumber  String?

    // Filled by admin after confirming (was nested pickupInfo JSON)
    meetingPoint   String?
    beThereAtDate  String?
    beThereAtTime  String?
    driverName     String?
    driverPhone    String?
    additionalInfo String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tripRequestId String
    tripRequest   TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)

    @@index([tripRequestId])
}

model TripMessage {
    id         String   @id @default(cuid())
    body       String            @db.Text
    senderType MessageSenderType
    senderName String

    createdAt DateTime @default(now())

    tripRequestId String
    tripRequest   TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)

    @@index([tripRequestId])
    @@index([createdAt])
}

model Quotation {
    id                       String          @id @default(cuid())
    price                    Decimal         @db.Decimal(10, 2)
    currency                 String          @default("EUR")
    isPriceEachWay           Boolean         @default(false)
    areCarSeatsIncluded      Boolean?
    quotationAdditionalInfo  String?         @db.Text
    status                   QuotationStatus @default(PENDING)
    notifiedAt               DateTime?
    respondedAt              DateTime?
    createdAt                DateTime        @default(now())
    updatedAt                DateTime        @updatedAt

    tripRequestId String
    tripRequest   TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)

    createdById String
    createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

    @@index([tripRequestId])
    @@index([status])
    @@index([createdAt])
}

model Notification {
    id           String           @id @default(cuid())
    type         NotificationType
    orderNumber  Int?
    customerName String?
    read         Boolean          @default(false)
    createdAt    DateTime         @default(now())

    userId        String
    user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    tripRequestId String?
    tripRequest   TripRequest? @relation(fields: [tripRequestId], references: [id], onDelete: SetNull)

    @@index([userId, read, createdAt])
    @@index([tripRequestId])
}
